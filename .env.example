# Server-only secrets. Never put these in dist/ or commit the real .env.
OPENAI_API_KEY=
# Set a Responses-compatible text model available to your OpenAI project.
OPENAI_MODEL=
# Alternative provider: use AI_* instead of OPENAI_*.
# Set the endpoint and approved model from your course announcement.
AI_API_KEY=
AI_MODEL=
# responses (OpenAI) or chat (OpenAI-compatible Chat Completions)
AI_API_FORMAT=responses
AI_BASE_URL=https://api.openai.com/v1
# Qwen hybrid-thinking chat models: false for short direct answers; blank otherwise.
AI_ENABLE_THINKING=
HOST=127.0.0.1
PORT=9019
REPORT_MAX_CALLS_PER_HOUR=30
